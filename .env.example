# EzWrite environment variables (example only - no secrets required)
# Copy this file to .env only if you later enable optional server-side AI settings.
# EzWrite starts and runs its prototype features without any API keys.

PORT=5173

# Optional server-side AI provider (keep as 'none' for local template mode)
# Supported values: none | openai-compatible
EZWRITE_AI_PROVIDER=none
EZWRITE_AI_API_KEY=
EZWRITE_AI_BASE_URL=https://api.openai.com/v1
EZWRITE_AI_MODEL=gpt-4o-mini
