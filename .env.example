# EzWrite environment variables (example only - no secrets required)
# Copy this file to .env only if you later enable optional settings.
# EzWrite starts and runs its prototype features without any API keys.

VITE_APP_NAME=EzWrite
VITE_DASHBOARD_PORT=5173

# Optional AI provider configuration for future steps (leave as 'none' for local mode)
VITE_AI_PROVIDER=none
OPENAI_API_KEY=
